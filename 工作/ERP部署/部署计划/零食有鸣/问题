# 1. 修复 .ssh 目录权限（关键）
chown root:root /root/.ssh
chmod 700 /root/.ssh

# 2. 修复 config 文件权限
chown root:root /root/.ssh/config
chmod 600 /root/.ssh/config

# 3. 确认修复结果
ls -la /root/.ssh/



